<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".MainActivity">

    <include
        android:id="@+id/screen_title"
        layout="@layout/screen_title" />

    <include
        android:id="@+id/screen_category"
        layout="@layout/screen_category"
        android:visibility="gone" />

    <include
        android:id="@+id/screen_question"
        layout="@layout/screen_question"
        android:visibility="gone" />

    <include
        android:id="@+id/screen_answer"
        layout="@layout/screen_answer"
        android:visibility="gone" />

    <include
        android:id="@+id/screen_result"
        layout="@layout/screen_result"
        android:visibility="gone" />

</FrameLayout>
